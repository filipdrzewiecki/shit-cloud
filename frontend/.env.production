# Loaded automatically by `npm run build` (also inside the Docker build).
# The API service's public Railway domain (project "shitcloud", environment "test").
VITE_API_BASE_URL=https://api-test-27f4.up.railway.app

# Builder sign-in (Auth0). Public values: a Single Page Application client has no secret.
# The client id comes from the VITE_AUTH0_CLIENT_ID variable on the Railway frontend service
# (a Docker build argument, see Dockerfile); it overrides the empty value below.
VITE_AUTH0_DOMAIN=my-intelligence.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://shit-cloud-api
