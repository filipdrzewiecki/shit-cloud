# Copied to .env.local for local development. Vite inlines every VITE_* value at
# build time, so these must be present wherever the bundle is built.

# The API's origin.
VITE_API_BASE_URL=http://localhost:8080

# Builder sign-in (Auth0). Public values: a Single Page Application client has no secret.
# The client id is filled in once the Auth0 tenant exists; until then only guest sign-in works.
VITE_AUTH0_DOMAIN=my-intelligence.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://shit-cloud-api
